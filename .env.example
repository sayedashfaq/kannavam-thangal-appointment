PORT=3000
NODE_ENV=development

# Timezone used for consultation days, token resets and reporting times
TIMEZONE=Asia/Kolkata

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kannavam-appointments

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# Optional: Meta App Secret enables webhook signature verification
WHATSAPP_APP_SECRET=

# Admin WhatsApp number (with country code, no + sign)
ADMIN_PHONE=919876543210

# true = spread reporting times across the sessions
# false = ask everyone to report at the start of the morning session
DYNAMIC_REPORTING_TIME=true
